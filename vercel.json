{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "destination": "https://www.minoru-dental.jp/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-dashboard",
      "schedule": "0 20 * * *"
    }
  ]
}
